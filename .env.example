# MediKiosk — environment configuration
#
# This prototype requires NO external API keys to run. Voice (Web Speech API),
# OCR (simulated), and ABHA/HIS integrations (mocked) all work out of the box.
#
# These variables are optional and only affect cosmetic/behavioural defaults.

# Port the app listens on when running `npm run dev` / `npm run start`
PORT=3000

# Node environment
NODE_ENV=development

# --- Future production integration points (NOT required for the demo) ---
# When replacing the mock services in lib/integrations/ with real ones, real
# credentials would be configured here, e.g.:
# ABDM_CLIENT_ID=
# ABDM_CLIENT_SECRET=
# HIS_FHIR_BASE_URL=
# CLOUD_OCR_API_KEY=
